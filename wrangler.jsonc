{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiz-crowd-runner",
  "main": "server/cloud.mjs",
  "compatibility_date": "2026-10-19",
  "account_id": "d00f61338fefb2242944521e341be0d6",
  "workers_dev": true,
  "assets": {"directory": "dist", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "vars": {"MINIMAX_REGION": "cn", "MINIMAX_MODEL": "MiniMax-M3"},
  "observability": {"enabled": false},
  "d1_databases": [{"binding": "DB", "database_name": "quiz-crowd-runner-budget", "database_id": "852546da-694b-47ad-8127-f2b6ec372130", "remote": true}]
}
